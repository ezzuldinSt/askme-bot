# AskMe bot configuration.
# Copy to .env and fill in your values (see README.md).

GEMINI_API_KEY=
THINGS_EMAIL=
THINGS_PASSWORD=

# Qdrant (start with: ./scripts/start_qdrant.sh)
QDRANT_URL=http://localhost:6334
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=10

# Memory recall
CONTEXT_SEARCH_LIMIT=50
CONTEXT_DEPTH_LIMIT=20
