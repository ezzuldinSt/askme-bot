# AskMe bot configuration.
# Copy to .env and fill in your values (see README.md).

# Gemini API keys — one or many. Multiple keys rotate round-robin per reply
# and fail over automatically on rate limits (useful for free-tier quotas).
GEMINI_API_KEY=
# Comma-separated alternative (used when GEMINI_API_KEY is not set):
# GEMINI_API_KEYS=key1,key2,key3

THINGS_EMAIL=
THINGS_PASSWORD=

# Models (editable later from the admin panel; generation model and thinking
# level apply instantly, embedding changes restart + wipe vector memory)
GENERATION_MODEL=gemini-3.6-flash
# Gemini 3.x reasoning effort: minimal | low | medium | high (unset = model default)
# THINKING_LEVEL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=10

# Qdrant (start with: ./scripts/start_qdrant.sh)
QDRANT_URL=http://localhost:6334

# Conversation memory (per-conversation, strictly isolated)
CONTEXT_DEPTH_LIMIT=20

# Long-term user memory (ChatGPT-style per-user facts)
# (thresholds below are tuned for gemini-embedding-2)
FACT_EXTRACTION_ENABLED=true
USER_FACTS_LIMIT=8
USER_FACT_SUPERSEDE_THRESHOLD=0.78
FORGET_SIMILARITY_THRESHOLD=0.75

# Things app knowledge (curated seed: things_knowledge.json)
APP_KNOWLEDGE_LIMIT=3
APP_KNOWLEDGE_MIN_SCORE=0.72

# Admin panel (password lives in bot_config.json; default CHANGEME on first boot)
ADMIN_BIND=0.0.0.0
ADMIN_PORT=1330
